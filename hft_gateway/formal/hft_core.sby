[tasks]
prove prv nas
cover nas
prove_lse prv lse

[options]
prv: mode prove
prv: depth 16
cover: mode cover
cover: depth 96

[engines]
smtbmc yices

[script]
read -formal crc32.v itch_parser.v mitch_parser.v risk_gate.v order_tx.v hft_core.v
nas: chparam -set BURST 2 -set REFILL 8 hft_core
lse: chparam -set VENUE 1 -set BURST 2 -set REFILL 8 hft_core
prep -top hft_core
#reached in risk_gate.sby
cover: chformal -remove -cover *risk_gate*

[files]
../rtl/crc32.v
../rtl/itch_parser.v
../rtl/mitch_parser.v
../rtl/risk_gate.v
../rtl/order_tx.v
../rtl/hft_core.v
