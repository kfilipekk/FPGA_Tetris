[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 16
cover: mode cover
cover: depth 96

[engines]
smtbmc yices

[script]
read -formal crc32.v itch_parser.v risk_gate.v ouch_tx.v hft_core.v
chparam -set BURST 2 -set REFILL 8 hft_core
prep -top hft_core
#reached in risk_gate.sby
cover: chformal -remove -cover *risk_gate*

[files]
../rtl/crc32.v
../rtl/itch_parser.v
../rtl/risk_gate.v
../rtl/ouch_tx.v
../rtl/hft_core.v
